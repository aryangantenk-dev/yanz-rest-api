# Semua variabel di bawah opsional. Tanpa database, situs & semua endpoint tetap
# berjalan; hanya statistik pemakaian dan pemendek URL bawaan (/api/tools/shorturl)
# yang nonaktif. Pilih SALAH SATU dari dua cara berikut.

# Cara 1 (disarankan untuk Vercel/Netlify): Supabase lewat REST.
# Jalankan supabase/schema.sql sekali di SQL Editor, lalu isi URL proyek dan
# service role / secret key (Project Settings > API Keys). Jangan pakai anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cara 2: connection string PostgreSQL (Neon, Vercel Postgres, Supabase pooler, dll.).
# Tabel dibuat otomatis saat pertama kali dipakai.
DATABASE_URL=

# Opsional. Domain produksi untuk canonical URL, sitemap, dan gambar Open Graph.
# Di Vercel tidak wajib (otomatis memakai domain produksi proyek).
NEXT_PUBLIC_SITE_URL=

# --- Batas pemakaian & blokir IP -------------------------------------------------
# Kunci rahasia owner untuk mengelola blokir IP. Wajib diisi agar endpoint admin aktif:
#   /api/admin/bans?key=...            daftar IP yang diblokir
#   /api/admin/unban?ip=1.2.3.4&key=... buka blokir
#   /api/admin/ban?ip=1.2.3.4&key=...   blokir manual
# Gunakan string acak yang panjang dan jangan dibagikan.
ADMIN_KEY=

# Opsional. Batas permintaan per menit untuk setiap IP (default 45).
RATE_LIMIT_PER_MIN=
# Opsional. Jumlah pelanggaran dalam 10 menit sebelum IP diblokir permanen (default 3).
BAN_AFTER_STRIKES=
# Opsional. Nomor WhatsApp owner untuk banding blokir (default 62895403334081).
OWNER_WHATSAPP=

# --- Server perantara JKT48 (kategori JKT48) ----------------------------------------
# jkt48.com menolak IP server hosting, jadi dipanggil lewat Supabase Edge Function.
# Deploy supabase/functions/film-proxy (tanpa verifikasi JWT), isi secret FILM_PROXY_KEY
# di Supabase, lalu tulis alamat fungsi dan kunci yang sama di sini. Nama fungsi dan nama
# env ini peninggalan versi lama. Dibiarkan kosong: jkt48.com dipanggil langsung.
# Contoh: https://<ref>.supabase.co/functions/v1/film-proxy
SANKA_PROXY_URL=
SANKA_PROXY_KEY=

# --- Web ke APK (/api/tools/web2apk) -------------------------------------------------
# Kunci API dari akunmu sendiri di layanan pembuat APK (menu API Builder di rfweb2apk.rfdevv.com).
# Akun gratis mendapat 3 build per hari; paket berbayar lebih banyak.
# Dibiarkan kosong: endpoint berjalan sebagai tamu, yang hanya mendapat 1 build per hari
# per alamat IP server, lalu menjawab 429.
WEB2APK_API_KEY=

# --- Layanan gratis Zefame (/api/tools/zefame-order) ---------------------------------
# API key layanan pemecah Turnstile api.izzxd.my.id. Dipakai untuk mendapat token Turnstile
# yang diwajibkan Zefame saat order. Dibiarkan kosong: order hanya berjalan bila pemanggil
# mengirim parameter token sendiri; selain itu endpoint menjawab 503.
# Endpoint pemecah itu khusus akun izzxd paket Pro; kunci paket gratis ditolak.
IZZXD_APIKEY=

# --- Gambar ke URL (/api/tools/tourl) ---------------------------------------------------
# Gambar unggahan disimpan di Supabase Storage, jadi fitur ini butuh SUPABASE_URL dan
# SUPABASE_SERVICE_ROLE_KEY di atas (DATABASE_URL saja tidak cukup). Bucket dibuat otomatis
# saat unggahan pertama. Tanpa Supabase endpoint ini menjawab 503.
# Opsional. Berapa hari gambar disimpan sebelum dihapus otomatis (default 30). Isi 0 untuk
# menyimpan selamanya; ingat kuota Storage paket gratis Supabase hanya 1 GB.
IMAGE_TTL_DAYS=
# Opsional. Nama bucket (default yanz-images).
IMAGE_BUCKET=

# --- Login dan API key -----------------------------------------------------------------
# Login butuh Supabase (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY di atas, dengan
# supabase/schema.sql sudah dijalankan), AUTH_SECRET, dan minimal satu cara masuk di bawah.
# Begitu login aktif, SEMUA endpoint /api/<kategori>/<nama> menolak permintaan tanpa API key
# (401). Selama login belum lengkap, endpoint tetap terbuka seperti biasa.
#
# Kunci acak minimal 32 karakter untuk menandatangani sesi dan kode verifikasi.
# Buat dengan: openssl rand -base64 48
# Mengganti nilainya membuat semua pengguna harus masuk lagi (API key mereka tetap berlaku).
AUTH_SECRET=

# Cara masuk 1: Google. Buat "OAuth client ID" jenis Web application di Google Cloud Console
# (APIs & Services > Credentials) dan daftarkan alamat balik:
#   https://<domain-kamu>/auth/google/callback
# Domain itu harus sama dengan NEXT_PUBLIC_SITE_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cara masuk 2: email dengan kode verifikasi 6 angka, dikirim lewat SMTP.
# Untuk Gmail: SMTP_USER = alamat Gmail, SMTP_PASS = "App password" 16 huruf
# (myaccount.google.com/apppasswords; butuh verifikasi 2 langkah), bukan kata sandi akun.
SMTP_USER=
SMTP_PASS=
# Opsional. Default smtp.gmail.com dan 465. Port 465 memakai TLS langsung, port lain STARTTLS.
SMTP_HOST=
SMTP_PORT=
# Opsional. Alamat pengirim bila berbeda dari SMTP_USER (harus diizinkan oleh server SMTP-nya).
MAIL_FROM=
# Opsional. Batas jumlah email kode per jam untuk seluruh situs (default 100).
# Gmail gratis membatasi sekitar 500 email per hari.
OTP_MAX_PER_HOUR=

# Opsional. Isi 0 untuk membuka lagi semua endpoint tanpa API key walau login aktif
# (mis. saat darurat). Login dan halaman akun tetap berjalan.
REQUIRE_API_KEY=

# Opsional. Penjualan paket di /paket lewat payment gateway QRIS Welper (https://welper.web.id/gateway/docs).
# API key (gwk_...) dan secret webhook (whsec_...) dari halaman Developer Welper. URL webhook yang
# didaftarkan di sana: <domain>/api/paket/webhook. Tanpa WELPER_API_KEY tombol bayar tidak tampil.
WELPER_API_KEY=
WELPER_WEBHOOK_SECRET=
# Opsional. customer (default: pembeli menanggung biaya QRIS) atau merchant.
WELPER_FEE_BEARER=

# Opsional. Worker di mesin sendiri (folder worker/, mis. mesin Instabox) untuk endpoint yang butuh
# browser, ffmpeg, atau model AI: tools/ssweb, tools/web2pdf, tools/tomp3, tools/togif, tools/compress,
# tools/sticker, tools/ocr, image/removebg, ai/transcribe, ai/tts.
# WORKER_URL = URL publik port 8080 mesin itu; WORKER_KEY = kunci yang dicetak worker/install.sh.
# Tanpa keduanya, endpoint di atas menjawab 503 dan endpoint lain tidak terpengaruh.
WORKER_URL=
WORKER_KEY=
