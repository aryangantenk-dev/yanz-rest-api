# Kunci rahasia antara yanz.api (Vercel) dan worker ini. install.sh mengisinya otomatis.
# Nilai yang sama diisi di Vercel sebagai WORKER_KEY.
WORKER_KEY=

# Opsional. Nilai di bawah adalah bawaannya.
# Port HTTP worker.
PORT=8080
# Ukuran model Whisper untuk suara ke teks: base (hemat RAM) atau small (lebih akurat).
# install.sh memilih base untuk mesin di bawah 5 GB RAM, dan small di atasnya.
WHISPER_MODEL=
# Jumlah pekerjaan berat yang berjalan bersamaan, dan panjang antrean sebelum permintaan ditolak.
MAX_JOBS=2
MAX_QUEUE=6
# Berkas hasil (mp3, gif, mp4, pdf) dihapus setelah sekian detik.
FILE_TTL_SEC=3600
# Batas ukuran berkas masukan (MB) dan durasi media (detik).
MAX_INPUT_MB=50
MAX_MEDIA_SEC=600
# Durasi maksimal audio untuk suara ke teks (detik).
MAX_SPEECH_SEC=180
